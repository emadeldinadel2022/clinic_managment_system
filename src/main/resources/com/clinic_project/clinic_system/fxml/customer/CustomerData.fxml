<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.clinic_project.clinic_system.presentation_layer.controllers.customer.CustomerDataController"
            style="-fx-background-color: #f5f7fa;">

    <!-- Left Sidebar -->
    <left>
        <VBox fx:id="sidebarMenu" spacing="5" prefWidth="250"
              style="-fx-background-color: #2c3e50; -fx-padding: 20;">

            <!-- Logo/Brand -->
            <VBox alignment="CENTER" spacing="5" style="-fx-padding: 0 0 20 0;">
                <Label text="Admin Portal" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Separator prefWidth="200" style="-fx-background-color: #34495e;"/>
            </VBox>

            <!-- Navigation Buttons -->
            <Button fx:id="analyticsBtn" text="📊 Analytics" maxWidth="Infinity" alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 15; -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button fx:id="uploadDataBtn" text="📤 Upload Data" maxWidth="Infinity" alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 15; -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button fx:id="customerDataBtn" text="👥 Customer Data" maxWidth="Infinity" alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 15; -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button fx:id="sendSMSBtn" text="💬 Send SMS" maxWidth="Infinity" alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 15; -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button fx:id="sendWhatsAppBtn" text="📱 WhatsApp" maxWidth="Infinity" alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 15; -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Separator prefWidth="200" style="-fx-background-color: #34495e;"/>

            <Button fx:id="logoutBtn" text="🚪 Logout" maxWidth="Infinity" alignment="CENTER_LEFT"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 15; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="25" style="-fx-padding: 30;">

                <!-- Header -->
                <VBox spacing="5">
                    <Label text="Customer Data Management" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <Label text="Add and manage customer information for messaging" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
                </VBox>

                <!-- Add Customer Form -->
                <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <Label text="Add New Customer" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                    <GridPane hgap="20" vgap="15">
                        <!-- Name Field -->
                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Full Name *" style="-fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                            <TextField fx:id="nameField" promptText="John Doe"
                                       style="-fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #ddd; -fx-border-radius: 6;"/>
                        </VBox>

                        <!-- Phone Field -->
                        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Phone Number *" style="-fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                            <TextField fx:id="phoneField" promptText="+1234567890"
                                       style="-fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #ddd; -fx-border-radius: 6;"/>
                        </VBox>

                        <!-- Email Field -->
                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="Email Address" style="-fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                            <TextField fx:id="emailField" promptText="john@example.com"
                                       style="-fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #ddd; -fx-border-radius: 6;"/>
                        </VBox>

                        <!-- Customer Type -->
                        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="Customer Type" style="-fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                            <ComboBox fx:id="customerTypeComboBox" prefWidth="250" promptText="Select type"
                                      style="-fx-font-size: 13px;"/>
                        </VBox>

                        <!-- Country -->
                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
                            <Label text="Country" style="-fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                            <ComboBox fx:id="countryComboBox" prefWidth="250" promptText="Select country"
                                      style="-fx-font-size: 13px;"/>
                        </VBox>

                        <!-- Language -->
                        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <Label text="Preferred Language" style="-fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                            <ComboBox fx:id="languageComboBox" prefWidth="250" promptText="Select language"
                                      style="-fx-font-size: 13px;"/>
                        </VBox>
                    </GridPane>

                    <Separator/>

                    <!-- Message Configuration -->
                    <VBox spacing="15">
                        <Label text="Message Configuration" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                        <HBox spacing="20">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Message Type" style="-fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                                <ComboBox fx:id="messageTypeComboBox" maxWidth="Infinity" promptText="Select message type"
                                          style="-fx-font-size: 13px;"/>
                            </VBox>

                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Delivery Method" style="-fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                                <ComboBox fx:id="deliveryMethodComboBox" maxWidth="Infinity" promptText="Select method"
                                          style="-fx-font-size: 13px;"/>
                            </VBox>
                        </HBox>

                        <VBox spacing="5">
                            <Label text="Message Template" style="-fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                            <TextArea fx:id="messageTemplateArea" prefRowCount="4" wrapText="true" promptText="Enter your message template here..."
                                      style="-fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #ddd; -fx-border-radius: 6;"/>
                            <Label text="Available variables: {name}, {phone}, {email}" style="-fx-font-size: 11px; -fx-text-fill: #95a5a6;"/>
                        </VBox>
                    </VBox>

                    <!-- Action Buttons -->
                    <HBox spacing="15" alignment="CENTER_RIGHT">
                        <Button fx:id="clearBtn" text="Clear Form"
                                style="-fx-background-color: #ecf0f1; -fx-text-fill: #2c3e50; -fx-font-size: 13px; -fx-padding: 10 25 10 25; -fx-background-radius: 6; -fx-cursor: hand;"/>
                        <Button fx:id="addCustomerBtn" text="Add Customer Send"
                                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 10 25 10 25; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    </HBox>

                    <Label fx:id="statusLabel" wrapText="true" style="-fx-font-size: 12px;"/>
                </VBox>

                <!-- Customer List -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="Customer List" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="searchField" promptText="🔍 Search customers..." prefWidth="300"
                                   style="-fx-padding: 8; -fx-background-radius: 6; -fx-border-color: #ddd; -fx-border-radius: 6;"/>
                        <Button text="Export" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 8 20 8 20; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    </HBox>

                    <TableView fx:id="customerTable" prefHeight="350">
                        <columns>
                            <TableColumn text="Name" prefWidth="180"/>
                            <TableColumn text="Phone" prefWidth="140"/>
                            <TableColumn text="Email" prefWidth="200"/>
                            <TableColumn text="Type" prefWidth="120"/>
                            <TableColumn text="Country" prefWidth="120"/>
                            <TableColumn text="Status" prefWidth="100"/>
                            <TableColumn text="Actions" prefWidth="150"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
