<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.clinic_project.clinic_system.controllers.SendSMSController"
            style="-fx-background-color: #f5f7fa;">

    <!-- Left Sidebar -->
    <left>
        <VBox fx:id="sidebarMenu" spacing="5" prefWidth="250"
              style="-fx-background-color: #2c3e50; -fx-padding: 20;">

            <!-- Logo/Brand -->
            <VBox alignment="CENTER" spacing="5" style="-fx-padding: 0 0 20 0;">
                <Label text="Admin Portal" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Separator prefWidth="200" style="-fx-background-color: #34495e;"/>
            </VBox>

            <!-- Navigation Buttons -->
            <Button fx:id="analyticsBtn" text="📊 Analytics" maxWidth="Infinity" alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 15; -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button fx:id="uploadDataBtn" text="📤 Upload Data" maxWidth="Infinity" alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 15; -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button fx:id="customerDataBtn" text="👥 Customer Data" maxWidth="Infinity" alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 15; -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button fx:id="sendSMSBtn" text="💬 Send SMS" maxWidth="Infinity" alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 15; -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button fx:id="sendWhatsAppBtn" text="📱 WhatsApp" maxWidth="Infinity" alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 15; -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Separator prefWidth="200" style="-fx-background-color: #34495e;"/>

            <Button fx:id="logoutBtn" text="🚪 Logout" maxWidth="Infinity" alignment="CENTER_LEFT"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 15; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="25" style="-fx-padding: 30;">

                <!-- Header -->
                <VBox spacing="5">
                    <Label text="Send SMS Messages" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <Label text="Send bulk SMS messages to your customers" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
                </VBox>

                <!-- Main SMS Form -->
                <VBox spacing="25" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">

                    <!-- Recipient Selection -->
                    <VBox spacing="15">
                        <Label text="1. Select Recipients" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                        <HBox spacing="20">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Recipient Type" style="-fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                                <ComboBox fx:id="recipientTypeComboBox" maxWidth="Infinity" promptText="Select recipient type"
                                          style="-fx-font-size: 13px; -fx-padding: 10;"/>
                            </VBox>

                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Filter by Country" style="-fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                                <ComboBox fx:id="countryFilterComboBox" maxWidth="Infinity" promptText="All countries"
                                          style="-fx-font-size: 13px; -fx-padding: 10;"/>
                            </VBox>
                        </HBox>

                        <!-- Custom Recipients -->
                        <VBox spacing="5">
                            <Label text="Or Enter Phone Numbers (one per line)" style="-fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                            <TextArea fx:id="recipientListArea" prefRowCount="4" promptText="+1234567890&#10;+9876543210&#10;..."
                                      style="-fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #ddd; -fx-border-radius: 6;"/>
                            <Label fx:id="recipientCountLabel" text="0 recipients selected" style="-fx-font-size: 12px; -fx-text-fill: #3498db;"/>
                        </VBox>
                    </VBox>

                    <Separator/>

                    <!-- Message Composition -->
                    <VBox spacing="15">
                        <Label text="2. Compose Message" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                        <HBox spacing="15">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Message Template" style="-fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                                <ComboBox fx:id="templateComboBox" maxWidth="Infinity" promptText="Choose a template"
                                          style="-fx-font-size: 13px; -fx-padding: 10;"/>
                            </VBox>

                            <Button text="Load Template" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 10 20 10 20; -fx-background-radius: 6; -fx-cursor: hand;">
                                <VBox.margin>
                                    <Insets top="20"/>
                                </VBox.margin>
                            </Button>
                        </HBox>

                        <VBox spacing="5">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="Message Content" style="-fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="charCountLabel" text="0/160 characters" style="-fx-font-size: 12px; -fx-text-fill: #95a5a6;"/>
                            </HBox>
                            <TextArea fx:id="messageArea" prefRowCount="6" wrapText="true" promptText="Type your SMS message here..."
                                      style="-fx-padding: 12; -fx-font-size: 13px; -fx-background-radius: 6; -fx-border-color: #ddd; -fx-border-radius: 6;"/>
                            <Label text="Use variables: {name}, {phone}, {company}" style="-fx-font-size: 11px; -fx-text-fill: #95a5a6;"/>
                        </VBox>

                        <!-- Message Preview -->
                        <VBox spacing="8" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 6;">
                            <Label text="Message Preview:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                            <Label fx:id="messagePreviewLabel" text="Your message preview will appear here" wrapText="true"
                                   style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
                        </VBox>
                    </VBox>

                    <Separator/>

                    <!-- Scheduling Options -->
                    <VBox spacing="15">
                        <Label text="3. Schedule (Optional)" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <RadioButton fx:id="sendNowRadio" text="Send Now" selected="true" style="-fx-font-size: 13px;"/>
                            <RadioButton fx:id="scheduleRadio" text="Schedule for Later" style="-fx-font-size: 13px;"/>
                        </HBox>

                        <HBox spacing="15" fx:id="scheduleBox" disable="true">
                            <VBox spacing="5">
                                <Label text="Date" style="-fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                                <DatePicker fx:id="scheduleDatePicker" prefWidth="200"
                                            style="-fx-font-size: 13px;"/>
                            </VBox>

                            <VBox spacing="5">
                                <Label text="Time" style="-fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                                <TextField fx:id="scheduleTimeField" promptText="HH:MM" prefWidth="120"
                                           style="-fx-padding: 8; -fx-background-radius: 6; -fx-border-color: #ddd; -fx-border-radius: 6;"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Progress and Status -->
                    <VBox spacing="10" fx:id="progressBox" visible="false" managed="false">
                        <Label text="Sending Messages..." style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <ProgressBar fx:id="progressBar" progress="0" prefWidth="Infinity" prefHeight="20"/>
                        <Label fx:id="progressLabel" text="0 of 0 sent" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                    </VBox>

                    <Label fx:id="statusLabel" wrapText="true" style="-fx-font-size: 13px;"/>

                    <!-- Action Buttons -->
                    <HBox spacing="15" alignment="CENTER_RIGHT">
                        <Button text="Preview" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 30 12 30; -fx-background-radius: 6; -fx-cursor: hand;"/>
                        <Button text="Save as Draft" style="-fx-background-color: #ecf0f1; -fx-text-fill: #2c3e50; -fx-font-size: 14px; -fx-padding: 12 30 12 30; -fx-background-radius: 6; -fx-cursor: hand;"/>
                        <Button fx:id="sendBtn" text="Send SMS" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 30 12 30; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <!-- SMS Statistics -->
                <GridPane hgap="15" vgap="15">
                    <VBox spacing="10" alignment="CENTER" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                          GridPane.columnIndex="0">
                        <Label text="📤" style="-fx-font-size: 32px;"/>
                        <Label text="Total Sent" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
                        <Label text="12,345" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    </VBox>

                    <VBox spacing="10" alignment="CENTER" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                          GridPane.columnIndex="1">
                        <Label text="✅" style="-fx-font-size: 32px;"/>
                        <Label text="Delivered" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
                        <Label text="11,876" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                    </VBox>

                    <VBox spacing="10" alignment="CENTER" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                          GridPane.columnIndex="2">
                        <Label text="⏳" style="-fx-font-size: 32px;"/>
                        <Label text="Pending" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
                        <Label text="234" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
                    </VBox>

                    <VBox spacing="10" alignment="CENTER" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                          GridPane.columnIndex="3">
                        <Label text="❌" style="-fx-font-size: 32px;"/>
                        <Label text="Failed" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
                        <Label text="235" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                    </VBox>
                </GridPane>

                <!-- Recent SMS History -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <Label text="Recent SMS Campaigns" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <TableView fx:id="smsHistoryTable" prefHeight="250">
                        <columns>
                            <TableColumn text="Date" prefWidth="150"/>
                            <TableColumn text="Recipients" prefWidth="100"/>
                            <TableColumn text="Message" prefWidth="300"/>
                            <TableColumn text="Status" prefWidth="120"/>
                            <TableColumn text="Delivered" prefWidth="100"/>
                            <TableColumn text="Actions" prefWidth="150"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
