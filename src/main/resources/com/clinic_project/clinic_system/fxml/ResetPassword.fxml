<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.clinic_project.clinic_system.controllers.ResetPasswordController"
           style="-fx-background-color: linear-gradient(to bottom right, #667eea 0%, #764ba2 100%);">

    <VBox alignment="CENTER" spacing="20" maxWidth="400" maxHeight="400"
          style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 20, 0, 0, 5);">
        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>

        <VBox alignment="CENTER" spacing="10">
            <Label text="Reset Password" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #667eea;"/>
            <Label text="Enter your email to reset password" wrapText="true" textAlignment="CENTER"
                   style="-fx-font-size: 13px; -fx-text-fill: #888;"/>
        </VBox>

        <VBox spacing="15">
            <VBox spacing="5">
                <Label text="Email Address" style="-fx-font-size: 13px; -fx-text-fill: #333;"/>
                <TextField fx:id="emailField" promptText="your.email@example.com"
                           style="-fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8;"/>
            </VBox>

            <Label fx:id="statusLabel" textFill="green" wrapText="true" style="-fx-font-size: 12px;"/>

            <Button fx:id="resetButton" text="Send Reset Link" maxWidth="Infinity"
                    style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand;">
                <VBox.margin>
                    <Insets top="10"/>
                </VBox.margin>
            </Button>
        </VBox>

        <Button fx:id="backToLoginButton" text="← Back to Login"
                style="-fx-background-color: transparent; -fx-text-fill: #667eea; -fx-cursor: hand;"/>
    </VBox>
</StackPane>