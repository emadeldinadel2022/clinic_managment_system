<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.clinc_project.clinec_system.controllers.SignupController"
           style="-fx-background-color: linear-gradient(to bottom right, #667eea 0%, #764ba2 100%);">

    <VBox alignment="CENTER" spacing="15" maxWidth="450" maxHeight="600"
          style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 20, 0, 0, 5);">
        <padding>
            <Insets top="30" right="40" bottom="30" left="40"/>
        </padding>

        <VBox alignment="CENTER" spacing="5">
            <Label text="Create Account" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #667eea;"/>
            <Label text="Join us today" style="-fx-font-size: 13px; -fx-text-fill: #888;"/>
        </VBox>

        <VBox spacing="12">
            <VBox spacing="5">
                <Label text="Full Name" style="-fx-font-size: 12px; -fx-text-fill: #333;"/>
                <TextField fx:id="fullNameField" promptText="John Doe"
                           style="-fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8;"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Email" style="-fx-font-size: 12px; -fx-text-fill: #333;"/>
                <TextField fx:id="emailField" promptText="john@example.com"
                           style="-fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8;"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Username" style="-fx-font-size: 12px; -fx-text-fill: #333;"/>
                <TextField fx:id="usernameField" promptText="Choose a username"
                           style="-fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8;"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Password" style="-fx-font-size: 12px; -fx-text-fill: #333;"/>
                <PasswordField fx:id="passwordField" promptText="Minimum 8 characters"
                               style="-fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8;"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Confirm Password" style="-fx-font-size: 12px; -fx-text-fill: #333;"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Re-enter password"
                               style="-fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8;"/>
            </VBox>

            <Label fx:id="errorLabel" textFill="red" wrapText="true" style="-fx-font-size: 11px;"/>

            <Button fx:id="signupButton" text="Create Account" maxWidth="Infinity"
                    style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand;">
                <VBox.margin>
                    <Insets top="5"/>
                </VBox.margin>
            </Button>
        </VBox>

        <HBox spacing="5" alignment="CENTER">
            <Label text="Already have an account?" style="-fx-text-fill: #666;"/>
            <Button fx:id="backToLoginButton" text="Sign In"
                    style="-fx-background-color: transparent; -fx-text-fill: #667eea; -fx-underline: true; -fx-cursor: hand;"/>
        </HBox>
    </VBox>
</StackPane>